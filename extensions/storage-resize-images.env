# Firebase "Resize Images" extension configuration (firebase/storage-resize-images).
#
# ADR-0003: originals upload to Storage; this extension generates the responsive variants
# `next/image` serves, on object finalize. It runs alongside the media-finalize Cloud
# Function (magic-byte re-derivation + quarantine) — the two are independent: the function
# decides whether the file is a genuine image and records dimensions; this produces the
# resized derivatives. A quarantined file's original is deleted by the function, so the
# extension either never sees it or its derivatives are orphaned and swept.
#
# Installed by the owner on the real project (`firebase ext:install` / `firebase deploy
# --only extensions`); the emulator does not run extensions, so the pipeline's function half
# is what the tests cover. Region matches the project (asia-south1) to avoid a cross-region
# hop per upload.

LOCATION=asia-south1

# Only process product media. Store assets and payment proofs are out of scope: assets are
# pre-sized at deploy, and a payment proof is evidence, not a rendered image.
IMG_BUCKET=
INCLUDE_PATH_LIST=/products

# The responsive widths next/image picks from. Heights are omitted so aspect ratio is kept.
IMG_SIZES=256,512,1024,1600

# WebP output — materially smaller than JPEG/PNG for product photography, and next.config
# already advertises AVIF/WebP to the browser. The original is kept so a re-process or a
# different pipeline later has the source.
IMG_TYPE=webp
DELETE_ORIGINAL_FILE=false

# Write the derivatives beside the original under a `resized/` prefix, so the object path the
# product document stores (the original) and the derivatives are easy to relate and to sweep.
RESIZED_IMAGES_PATH=resized

# Don't make the extension a second write path into Firestore — the media-finalize function
# owns the product document. This keeps the two halves of the pipeline from racing on it.
FUNCTION_MEMORY=512
