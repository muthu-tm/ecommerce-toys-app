# Local E2E — emulator profile
# ---------------------------------------------------------------------------
# This is the single source of truth for the "emulator" profile the orchestrator
# (`pnpm e2e`) injects into every service. Copy to `.env.e2e` to override any value
# locally; the orchestrator applies these defaults even without the copy.
#
# Everything here is safe to commit — there are no secrets. The Firebase web config is
# synthetic because the emulator ignores it (see apps/*/src/lib/firebase-emulator.ts),
# so a full offline run needs no real Firebase project.
#
# Ports mirror firebase.json: Auth 9099, Firestore 8181, Storage 9199, Functions 5001,
# Pub/Sub 8085, UI 4000, Hub 4400. Firestore is on 8181 (not the default 8080, which
# collides with Docker).

# --- Which store to run -----------------------------------------------------
STORE_ID=romp
NEXT_PUBLIC_STORE_ID=romp

# --- Emulator project (demo- prefix keeps the emulators fully offline) -------
GCLOUD_PROJECT=demo-romp
GOOGLE_CLOUD_PROJECT=demo-romp

# --- Server-side Admin SDK → emulator (read by firebase-admin automatically) -
FIRESTORE_EMULATOR_HOST=127.0.0.1:8181
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- API service ------------------------------------------------------------
PORT=8787
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# A dev fallback exists in bootstrap.ts; set explicitly to mirror a real deploy.
CART_COOKIE_SECRET=dev-e2e-cart-cookie-secret

# A known admin password for deterministic E2E sign-in. Honoured by `pnpm seed:admins`
# ONLY when the Auth emulator is the target — inert against any real project.
ADMIN_SEED_PASSWORD=e2e-admin-password-01

# --- Storefront / Admin → API ----------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Product media base. Locally the development placeholder artwork is copied by
# `pnpm store:tokens` into each app's public/media/, so a same-origin `/media` base serves
# it with no Storage host. In a real deploy this is the Cloudflare-fronted Storage domain
# (see apps/storefront/apphosting.yaml). Unset, cards fall back to the placeholder tile.
NEXT_PUBLIC_MEDIA_BASE_URL=/media

# --- Client (browser) SDK → emulator ----------------------------------------
# The flag that turns on connect*Emulator in the browser SDK. Off/absent in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_HOST=127.0.0.1:8181
NEXT_PUBLIC_FIREBASE_STORAGE_HOST=127.0.0.1:9199

# Synthetic web config — the emulator validates none of these. Only the project id
# matters, so the browser SDK and the seeded data share the emulator project.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-romp
NEXT_PUBLIC_FIREBASE_API_KEY=emulator-api-key
NEXT_PUBLIC_FIREBASE_APP_ID=emulator-app-id
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-romp.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-romp.appspot.com
