{
  "name": "@romp/infra",
  "version": "0.1.0",
  "private": true,
  "description": "Firebase security rules, indexes, and the emulator-backed tests that prove them",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-emulator-tests.mjs",
    "test:watch": "node scripts/run-emulator-tests.mjs --watch",
    "clean": "rm -rf .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@romp/api": "workspace:*",
    "@romp/config": "workspace:*",
    "@romp/contracts": "workspace:*",
    "@romp/data": "workspace:*",
    "@romp/observability": "workspace:*",
    "@romp/store-config": "workspace:*",
    "@types/node": "^26.5.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.29.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
