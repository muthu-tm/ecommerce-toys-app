# apps/storefront — environment
# ---------------------------------------------------------------------------
# Copy to `.env.local` for a standalone `pnpm --filter @romp/storefront dev`.
# When you use the orchestrator (`pnpm e2e`), it injects the emulator profile
# and you do not need this file.

# ===== Profile A: emulator (fully offline, no real Firebase project) =======
STORE_ID=romp
NEXT_PUBLIC_STORE_ID=romp

# SSR reads (Admin SDK) → emulator
GCLOUD_PROJECT=demo-romp
FIRESTORE_EMULATOR_HOST=127.0.0.1:8181

# API origin
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Browser SDK → emulator. The flag turns on connect*Emulator; the web config is
# synthetic because the emulator ignores it.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_HOST=127.0.0.1:8181
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-romp
NEXT_PUBLIC_FIREBASE_API_KEY=emulator-api-key
NEXT_PUBLIC_FIREBASE_APP_ID=emulator-app-id
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-romp.firebaseapp.com

# ===== Profile B: real Firebase project =====================================
# Comment out Profile A's emulator lines (GCLOUD_PROJECT stays if you want SSR
# against the real project via ADC), leave NEXT_PUBLIC_USE_FIREBASE_EMULATOR
# unset, and paste the real web config from the Firebase console:
# NEXT_PUBLIC_FIREBASE_API_KEY=...
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project>
# NEXT_PUBLIC_FIREBASE_APP_ID=...
