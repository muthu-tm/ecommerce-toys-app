{
  "name": "@romp/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API on Cloud Functions v2 — owns every write in the system",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./deps": "./src/deps.ts",
    "./notifications/dispatcher": "./src/notifications/dispatcher.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx watch src/dev-server.ts",
    "build": "node scripts/build.mjs",
    "openapi:generate": "tsx scripts/openapi.mjs",
    "openapi:check": "tsx scripts/openapi.mjs --check",
    "seed:admins": "tsx scripts/seed-admins.ts",
    "clean": "rm -rf .turbo coverage lib *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@romp/contracts": "workspace:*",
    "@romp/core": "workspace:*",
    "@romp/data": "workspace:*",
    "@romp/observability": "workspace:*",
    "@romp/store-config": "workspace:*",
    "fastify": "^5.2.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@romp/config": "workspace:*",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
