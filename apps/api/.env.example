# apps/api — environment
# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in for a standalone run. When you use the
# orchestrator (`pnpm e2e`), it injects the emulator profile for you and you do
# not need this file. This exists for running `pnpm --filter @romp/api dev`
# directly, or pointing the API at a real project.

# ===== Profile A: emulator (fully offline) =================================
# The Admin SDK auto-routes to the emulator when these host vars are set.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8181
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
GCLOUD_PROJECT=demo-romp

# ===== Profile B: real project (comment out Profile A first) ================
# No emulator host vars. The Admin SDK uses Application Default Credentials
# (gcloud auth application-default login) against the real project.
# GOOGLE_CLOUD_PROJECT=romp-dev

# ===== Common (both profiles) ==============================================
PORT=8787
# The storefront and admin origins allowed to call this API. No wildcard.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Per-environment secret for signing the guest cart cookie. A dev fallback
# exists; set it here to mirror a real deploy.
CART_COOKIE_SECRET=dev-cart-cookie-secret
