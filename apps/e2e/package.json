{
  "name": "@romp/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright end-to-end tests — customer and admin happy-path flows against the local emulator stack",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium",
    "clean": "rm -rf .turbo playwright-report test-results .e2e-state *.tsbuildinfo"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@romp/config": "workspace:*",
    "@types/node": "^26.5.0",
    "typescript": "^5.7.2"
  }
}
