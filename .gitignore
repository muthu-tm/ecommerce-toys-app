# dependencies
node_modules/
.pnpm-store/

# build output
dist/
lib/
# `lib/` above targets compiled output (e.g. apps/api builds to lib/). It must not
# swallow `src/lib/`, which is real application source in the Next.js apps — the same
# distinction the ESLint ignore draws (`lib/**` not `**/lib/**`).
!**/src/lib/
!**/src/lib/**
.next/
out/
*.tsbuildinfo

# turbo
.turbo/

# test output
coverage/
test-results/
playwright-report/
.vitest-reports/

# environment — never commit secrets
.env
.env.*
!.env.example
!.env.*.example
*.local

# local e2e orchestrator runtime (pids, logs)
.e2e/
# playwright cross-project handoff state
apps/e2e/.e2e-state/

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
firestore-export/
serviceAccount*.json
!serviceAccount.example.json

# generated white-label artefacts
packages/store-config/generated/
apps/*/src/generated/

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*
apps/*/public/brand/
apps/*/public/media/
next-env.d.ts
