{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // Toolchain presets (`@romp/config/vitest`, `@romp/config/policy`) are plain
    // ESM so Node can load them from a consumer's config file. `allowJs` lets
    // TypeScript read their JSDoc types instead of us maintaining a parallel set
    // of hand-written declarations. `checkJs` stays off here and is enabled only
    // in the package that owns those files.
    "allowJs": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "useUnknownInCatchVariables": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true
  },
  "exclude": ["node_modules", "dist", "lib", ".next", "coverage", ".turbo"]
}
