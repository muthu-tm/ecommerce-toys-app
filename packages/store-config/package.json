{
  "name": "@romp/store-config",
  "version": "0.1.0",
  "private": true,
  "description": "White-label store configuration: schema, fail-fast loader, contrast validation, token emitter",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./loader": "./src/loader.ts",
    "./generated/store-config.json": "./generated/store-config.json"
  },
  "files": [
    "src",
    "generated/store-config.json"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tokens": "jiti scripts/generate-tokens.ts",
    "store:new": "jiti scripts/new-store.ts",
    "clean": "rm -rf .turbo coverage generated *.tsbuildinfo"
  },
  "dependencies": {
    "@romp/contracts": "workspace:*",
    "@romp/core": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@romp/config": "workspace:*",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jiti": "^2.7.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
