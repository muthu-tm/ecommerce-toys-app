{
  "name": "@romp/data",
  "version": "0.1.0",
  "private": true,
  "description": "Firestore collection paths, validating converters, and the config-driven seed",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./src/seed/index.ts",
    "./test-support": "./src/test-support/firestore-recorder.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "jiti scripts/seed.ts",
    "reconcile:variant": "jiti scripts/reconcile.ts",
    "reconcile:categories": "jiti scripts/reconcile-categories.ts",
    "clean": "rm -rf .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@romp/contracts": "workspace:*",
    "@romp/core": "workspace:*",
    "@romp/observability": "workspace:*",
    "@romp/store-config": "workspace:*",
    "firebase-admin": "^14.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@romp/config": "workspace:*",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jiti": "^2.6.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
